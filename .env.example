# URL RTSP/HTTP genérica (opcional y prioritaria sobre la configuración Tapo).
CAMARA_RTSP_URL=

# Cámara Tapo RTSP (opcional; si falta se usa la webcam local).
TAPO_USER=
TAPO_PASS=
TAPO_IP=

# Índice de la webcam local.
CAMARA_PC_INDICE=0

# Zonas fijas opcionales: puntos normalizados "x,y;x,y;..." entre 0 y 1.
# Si se omiten, se crean zonas temporales alrededor de los platos detectados.
ZONA_COMEDERO=
ZONA_BEBEDERO=

# Azure SQL Database (opcional para ejecutar el monitor en modo local).
AZURE_SERVER=
AZURE_DATABASE=
AZURE_USERNAME=
AZURE_PASSWORD=
AZURE_DRIVER={ODBC Driver 18 for SQL Server}

# Azure AI Foundry / Responses API (opcional).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=

# API privada usada por las herramientas del asistente.
NINFAS_AGENT_API_KEY=
NINFAS_AGENT_API_URL=http://127.0.0.1:8124

# Opcional: necesaria para administrar aves o usar Foundry desde otro equipo.
# Las operaciones remotas con clave requieren HTTPS.
# Si se omite, esas operaciones solo se aceptan desde localhost.
NINFAS_ADMIN_API_KEY=

# Hosts HTTP admitidos. Agrega aquí el dominio o IP si publicas el panel.
NINFAS_ALLOWED_HOSTS=127.0.0.1,localhost

# La documentación interactiva de la API está desactivada por defecto.
NINFAS_ENABLE_DOCS=0

# Solo si Foundry debe llamar la API desde Internet.
NINFAS_AGENT_PUBLIC_URL=
