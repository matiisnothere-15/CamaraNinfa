# URL RTSP/HTTP genérica (opcional y prioritaria sobre la configuración Tapo).
CAMARA_RTSP_URL=

# Cámara Tapo RTSP (opcional; si falta se usa la ventana o webcam local).
TAPO_USER=
TAPO_PASS=
TAPO_IP=

# Captura de ventana de escritorio en Windows (opcional, p. ej. BlueStacks).
# Tiene prioridad sobre CAMARA_PC_INDICE cuando no hay RTSP/Tapo configurado.
CAMARA_VENTANA=

# Índice de la webcam local.
CAMARA_PC_INDICE=0

# Detector de visión predeterminado: rfdetr (YOLO desactivado por defecto) o yolo.
NINFAS_DETECTOR=rfdetr
# Model ID de RF-DETR en Roboflow (usado por el backend inference).
ROBOFLOW_MODEL_ID=monitorninfas20/monitorninfas-5-rfdetr-nas-base-t1--96ff59
# API Key de Roboflow para descargar/cachear RF-DETR localmente la primera vez (sin secreto aquí).
ROBOFLOW_API_KEY=
# Ruta opcional a pesos .pth locales de RF-DETR (requiere el paquete rfdetr).
RFDETR_WEIGHTS_PATH=

# Modo sin ventana gráfica OpenCV (1 para servidor mini dedicado / headless).
NINFAS_HEADLESS=0
# Permite desactivar el segundo stream RTSP de audio (0) si la cámara limita conexiones.
NINFAS_AUDIO_RTSP=1
# Activa recolección automática de frames difíciles (1) para reentrenar el modelo.
NINFAS_AUTO_DATASET=0

# Zonas fijas opcionales: puntos normalizados "x,y;x,y;..." entre 0 y 1.
# Si se omiten, se crean zonas temporales alrededor de los platos detectados.
ZONA_COMEDERO=
ZONA_BEBEDERO=
# Si se define en 0, desactiva el fallback de zonas dinámicas por detección.
NINFAS_ZONAS_DINAMICAS=1

# Intervalo en segundos entre snapshots periódicos a Azure SQL (mínimo 60).
NINFAS_SNAPSHOT_INTERVALO=300

# Azure SQL Database (opcional para ejecutar el monitor en modo local).
AZURE_SERVER=
AZURE_DATABASE=
AZURE_USERNAME=
AZURE_PASSWORD=
AZURE_DRIVER={ODBC Driver 18 for SQL Server}

# Microsoft Foundry / Responses API (opcional).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=

# API privada usada por las herramientas del asistente.
NINFAS_AGENT_API_KEY=
NINFAS_AGENT_API_URL=http://127.0.0.1:8124

# Opcional: necesaria para administrar aves o usar Foundry desde otro equipo.
# Las operaciones remotas con clave requieren HTTPS.
# Si se omite, esas operaciones solo se aceptan desde localhost.
NINFAS_ADMIN_API_KEY=

# Hosts HTTP admitidos. Agrega aquí el dominio o IP si publicas el panel.
NINFAS_ALLOWED_HOSTS=127.0.0.1,localhost

# La documentación interactiva de la API está desactivada por defecto.
NINFAS_ENABLE_DOCS=0

# Solo si Foundry debe llamar la API desde Internet.
NINFAS_AGENT_PUBLIC_URL=

# Notificaciones push opcionales para alertas clínicas (>4h sin comer/beber o estado Desesperado).
# Webhook HTTPS (Discord, Slack, Ntfy, etc.) o Telegram Bot API:
NINFAS_ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
