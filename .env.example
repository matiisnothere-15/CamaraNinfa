# Copia esta plantilla a .env sin sobrescribir credenciales existentes.
# RF-DETR NAS de Roboflow (inferencia local, descarga inicial autenticada).
NINFAS_DETECTOR=rfdetr
ROBOFLOW_MODEL_ID=monitorninfas20/monitorninfas-5-rfdetr-nas-base-t1--96ff59
ROBOFLOW_API_KEY=
RFDETR_WEIGHTS_PATH=

# Fuente: URL completa > Tapo > ventana Windows > webcam.
CAMARA_RTSP_URL=
TAPO_USER=
TAPO_PASS=
TAPO_IP=
CAMARA_VENTANA=
CAMARA_PC_INDICE=0
NINFAS_HEADLESS=0
NINFAS_AUDIO_RTSP=1

# Zonas normalizadas opcionales; vacías utilizan los platos detectados.
ZONA_COMEDERO=
ZONA_BEBEDERO=
NINFAS_ZONAS_DINAMICAS=1
NINFAS_AUTO_DATASET=0
NINFAS_SNAPSHOT_INTERVALO=300
# Opcional: 08:00-20:00; vacío conserva detección de luz por imagen.
NINFAS_HORARIO_DIURNO=

# Persistencia y panel opcionales.
AZURE_SERVER=
AZURE_DATABASE=
AZURE_USERNAME=
AZURE_PASSWORD=
AZURE_DRIVER={ODBC Driver 18 for SQL Server}

# Asistente opcional.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=
NINFAS_AGENT_API_KEY=
NINFAS_AGENT_API_URL=http://127.0.0.1:8124
NINFAS_AGENT_PUBLIC_URL=
NINFAS_ADMIN_API_KEY=
NINFAS_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
NINFAS_ENABLE_DOCS=0

# Notificaciones opcionales.
NINFAS_ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
